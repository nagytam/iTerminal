<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The file-format readers, renderers and the converter that turns a file into text. They live beside iConsole
    rather than in it, so that a format library (SkiaSharp and its natives, Svg.Skia, the Office, PDF, TOML/YAML,
    Parquet, HDF5 and SQLite packages) is restored only by the projects that read those formats, not by every project
    that references the UI framework. Their namespaces are `iConsole.Formats.*`; the contracts they implement stay in `iConsole.*`. iConsole does not reference this project; the
    composition root registers the converter and the readers with AddFileFormats.
  -->
  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="Iced" Version="1.22.0" />
    <PackageReference Include="JetDatabaseReader" Version="3.0.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="OpenMcdf" Version="3.3.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageReference Include="Tomlyn" Version="2.11.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <!-- The HDF5 viewer (F3): PureHDF is fully managed. -->
    <PackageReference Include="PureHDF" Version="2.2.0" />
    <!-- The Parquet viewer (F3): fully managed, MIT. The reader decodes the first rows only; see Parquet. -->
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
    <!-- The SQLite viewer (F3) and the read-only reader behind it. iTerminal.Core references it too (EF Core). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\iConsole\iConsole.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Static analysis for every non-test project. PrivateAssets keeps the analyzer out of consumers. -->
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.37.0.15768" PrivateAssets="all" />
  </ItemGroup>

</Project>
