<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Interfaces\**" />
    <EmbeddedResource Remove="Interfaces\**" />
    <None Remove="Interfaces\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" Version="55.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageReference Include="imobiledevice-net" Version="1.3.17" />
    <!--
      The library only. Its build assets would copy the Playwright driver (a Node.js runtime, ~130 MB, and
      the JavaScript package) into every output and package. The driver is downloaded into the data folder
      by the setup dialog instead (see RuntimeDependencyService), so the build must not carry it.
    -->
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="8.0.0-dev-02318" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="SMBLibrary" Version="1.5.8.1" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- The zstd decoder for the Ollama release, which Linux ships as .tar.zst (.NET has none in its BCL). -->
    <PackageReference Include="ZstdSharp.Port" Version="0.7.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\iConsole.Inputs.Windows\iConsole.Inputs.Windows.csproj" />
    <ProjectReference Include="..\iConsole\iConsole.csproj" />
  </ItemGroup>

</Project>
