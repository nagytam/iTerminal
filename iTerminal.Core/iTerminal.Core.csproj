<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Interfaces\**" />
    <EmbeddedResource Remove="Interfaces\**" />
    <None Remove="Interfaces\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
    <PackageReference Include="FluentFTP" Version="55.1.0" />
    <PackageReference Include="NfsSharp.Client" Version="1.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="11.0.1" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.1" />
    <PackageReference Include="imobiledevice-net" Version="1.3.17" />
    <PackageReference Include="Microsoft.Mxc.Sdk" Version="1.1.0" />
    <!--
      The library only. Its build assets would copy the Playwright driver (a Node.js runtime, ~130 MB, and
      the JavaScript package) into every output and package. The driver is downloaded into the data folder
      by the setup dialog instead (see RuntimeDependencyService), so the build must not carry it.
    -->
    <PackageReference Include="Microsoft.Playwright" Version="1.65.1" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="8.0.0-dev-02318" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="SMBLibrary" Version="1.5.8.1" />
    <PackageReference Include="SSH.NET" Version="2026.0.1" />
    <!-- SkiaSharp and Svg.Skia (the SVG and picture decoders) arrive through iConsole.Media.Video and iConsole.Formats,
         which own their versions and natives; do not repeat them here. -->
    <!-- The zstd decoder for the Ollama release, which Linux ships as .tar.zst (.NET has none in its BCL). -->
    <PackageReference Include="ZstdSharp.Port" Version="0.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\iConsole.Formats\iConsole.Formats.csproj" />
    <ProjectReference Include="..\iConsole.Media.Audio\iConsole.Media.Audio.csproj" />
    <ProjectReference Include="..\iConsole.Media.Speech\iConsole.Media.Speech.csproj" />
    <ProjectReference Include="..\iConsole.Media.Video\iConsole.Media.Video.csproj" />
    <ProjectReference Include="..\iTerminal.Core.Games\iTerminal.Core.Games.csproj" />
    <ProjectReference Include="..\iTerminal.Security\iTerminal.Security.csproj" />
    <ProjectReference Include="..\iConsole\iConsole.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Static analysis for every non-test project. PrivateAssets keeps the analyzer out of consumers. -->
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.37.0.15768" PrivateAssets="all" />
  </ItemGroup>

</Project>
