<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Controls\Experimental\MenuBar\**" />
    <EmbeddedResource Remove="Controls\Experimental\MenuBar\**" />
    <None Remove="Controls\Experimental\MenuBar\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Microsoft.FeatureManagement" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Static analysis for every non-test project. PrivateAssets keeps the analyzer out of consumers. -->
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.37.0.15768" PrivateAssets="all" />
  </ItemGroup>

</Project>
