<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- The suite runs about 45 workers at once, and workstation GC stops every one of them for each collection.
         Server GC collects on a heap per core, which took the run from about 52 s to about 34 s on a 48-core machine. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>

    <!-- Dynamic PGO instruments every method for the first few thousand calls. Each test runs a short, cold path once,
         so the instrumentation costs more than the optimised code gains: about 2-3 s off the run on a 48-core machine. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\iConsole.Test.Core\iConsole.Test.Core.csproj" />
    <ProjectReference Include="..\iTerminal.Core\iTerminal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Audio\TestFiles\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The archive examples in Test/FileTypes, copied beside the tests so they read the same files a user does. -->
  <ItemGroup>
    <None Include="..\Test\FileTypes\example.deb" Link="FileTypes\example.deb" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Test\FileTypes\example.rpm" Link="FileTypes\example.rpm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Test\FileTypes\example.chm" Link="FileTypes\example.chm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Test\FileTypes\example.arj" Link="FileTypes\example.arj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Test\FileTypes\example.lzma" Link="FileTypes\example.lzma" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Test\FileTypes\example.jar" Link="FileTypes\example.jar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Test\FileTypes\example.apk" Link="FileTypes\example.apk" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Test\FileTypes\example.nupkg" Link="FileTypes\example.nupkg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Test\FileTypes\example.vsix" Link="FileTypes\example.vsix" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
