-- A small T-SQL batch: a greeting, a table of readings and a summary.
SET NOCOUNT ON;

DECLARE @count INT = 0;
DECLARE @message NVARCHAR(100) = N'Hello from iTerminal';

CREATE TABLE #Readings (
    Id INT IDENTITY(1, 1) PRIMARY KEY,
    Value DECIMAL(9, 2) NOT NULL
);

INSERT INTO #Readings (Value) VALUES (1.50), (2.00), (32.50), (-0.40), (10.00);

SELECT @count = COUNT(*) FROM #Readings WHERE Value > 0;
PRINT @message + ' (' + CAST(@count AS VARCHAR(10)) + ' positive)';
GO

/* A block comment
   over two lines. */
BEGIN TRY
    IF @count > 3
        SELECT TOP (3) Id, Value FROM #Readings ORDER BY Value DESC;
    ELSE
        RAISERROR('Too few readings', 16, 1);
END TRY
BEGIN CATCH
    PRINT ERROR_MESSAGE();
END CATCH;
